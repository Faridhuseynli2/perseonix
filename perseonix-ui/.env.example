# Copy to .env.local for local development.

# Bootstraps the first administrator when the database has no users.
# The account is flagged to choose a new password at first sign-in.
SEED_ADMIN_EMAIL=admin@perseonix.local
SEED_ADMIN_PASSWORD=change-me-to-a-long-random-value

# Public base URL shown in the sign-in details handed to new users.
# Defaults to the host of the admin's current request.
# APP_URL=https://portal.perseonix.com

# Number of reverse proxies in front of the app that append to X-Forwarded-For
# (used for rate limiting and audit IPs). Defaults to 1.
# TRUSTED_PROXY_COUNT=1

# --- Threat Investigation module ---
# Investigations per customer company per UTC day (administrators are unlimited).
# INVESTIGATION_DAILY_LIMIT=200
# DNS resolvers used for lookups (comma-separated). Defaults to Cloudflare and Google.
# DNS_RESOLVERS=1.1.1.1,8.8.8.8
# Optional: Shodan internet-exposure data (open ports, services, CVEs, tags).
# Check Shodan's licensing before showing its data to paying customers.
# SHODAN_API_KEY=
# Optional: VirusTotal vendor detections (lookups only; nothing is submitted).
# The free public API is for non-commercial use: 4 lookups/minute, 500/day.
# Raise the limits below only with a premium key.
# VIRUSTOTAL_API_KEY=
# VIRUSTOTAL_RATE_PER_MINUTE=4
# VIRUSTOTAL_DAILY_LIMIT=500
# Optional: AbuseIPDB crowd-sourced abuse reports. The free plan is for
# non-commercial use (1,000 checks/day); paying customers need a paid plan.
# ABUSEIPDB_API_KEY=
# ABUSEIPDB_DAILY_LIMIT=1000
# Optional: abuse.ch URLhaus malware-URL feed (Auth-Key from https://auth.abuse.ch).
# Free for non-commercial use only; commercial use needs a Spamhaus subscription.
# ABUSECH_AUTH_KEY=
# Optional: private screenshot scans via urlscan.io. Using urlscan.io with paying
# customers requires a commercial agreement with them (https://urlscan.io/terms/).
# URLSCAN_API_KEY=
# Optional: Ransomware Tracker source. The ransomware.live free v2 API needs NO key
# (personal use only, 1 req/min). Paste a PRO key here (or in admin → Connectors)
# for business use. https://www.ransomware.live/api
# RANSOMWARE_LIVE_API_KEY=

# Page capture: opens the target in an isolated headless browser (screenshot,
# redirects, contacted hosts). Needs Chromium: run
#   npx playwright-core install chromium-headless-shell
# or point SANDBOX_BROWSER_PATH at a Chrome/Chromium binary. In production, run
# the app on a host that is isolated from internal networks.
# SANDBOX_BROWSER_PATH=
# SANDBOX_DISABLED=1
# Where screenshots are stored. Defaults to ./.data/captures
# CAPTURE_DIR=./.data/captures

# Optional: where the local PGlite (Postgres) database lives. Defaults to ./.data/pglite
# PGLITE_DATA_DIR=./.data/pglite
